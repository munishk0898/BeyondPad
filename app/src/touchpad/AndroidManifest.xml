<?xml version="1.0" encoding="utf-8"?>
<!-- Touchpad edition only: the Accessibility service. Google Play Protect blocks sideloaded apps
     that declare one in some regions (including India), so the standard edition leaves it out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".touch.TouchpadService"
            android:exported="false"
            android:label="@string/touchpad_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touchpad_service" />
        </service>
    </application>
</manifest>
